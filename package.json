{
  "name": "aquarius",
  "private": true,
  "description": "Community governance platform - what Bitcoin is to money, Aquarius is to community",
  "scripts": {
    "mobile": "pnpm --filter @aquarius/mobile start",
    "api": "pnpm --filter @aquarius/api dev",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote@1": "^1.8.4",
      "brace-expansion@5": "^5.0.6",
      "ws@8": "^8.20.1",
      "uuid@7": "^11.1.1",
      "uuid@8": "^11.1.1",
      "postcss@<8.5.10": "^8.5.10",
      "node-fetch@<2.6.7": "^2.6.7"
    }
  }
}