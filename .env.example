# Aquarius Environment Configuration
# Copy this to .env and fill in your values

# ── API Server ──────────────────────────────────
# Anthropic API key for AI legal document generation / Blue fallback
# Paid AI routes (legal generate/summarize, blue chat) require a wallet session.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional xAI key for Blue (preferred when set)
# XAI_API_KEY=

# API port (default 3001)
PORT=3001

# Set to production in deployed environments (also honors NODE_ENV=production)
# AQUARIUS_ENV=production

# Required in production: HMAC secret for API session tokens
# Generate with: openssl rand -hex 32
AQUARIUS_AUTH_SECRET=

# Comma-separated browser origins allowed by CORS.
# In development, localhost Expo/web origins are used when unset.
# In production, leave unset to deny browser cross-origin, or set explicitly.
# AQUARIUS_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Public base URL used in generated agent-card metadata URIs
# AQUARIUS_PUBLIC_API_BASE_URL=https://api.example.com

# ── Agent security ──────────────────────────────
# Encrypts generated agent private keys before in-memory storage
# AGENT_KEY_ENCRYPTION_SECRET=

# Opt-in gate for operator wallet funding / on-chain registration (default: off)
# AGENT_OPERATOR_ACTIONS_ENABLED=false

# Optional comma-separated wallet allowlist for operator-funded actions
# AGENT_OPERATOR_ALLOWLIST=0xYourAdminWallet

# Max ETH the API will send when initialFundingEth > 0 (default 0.01)
# AGENT_MAX_INITIAL_FUNDING_ETH=0.01

# Operator wallet used only when operator actions are enabled
# AQUARIUS_OPERATOR_PRIVATE_KEY=0x_your_operator_private_key
# AQUARIUS_RPC_URL=https://sepolia.base.org

# ── Smart Contract Deployment ────────────────────
# Private key for deploying contracts (DO NOT commit real keys)
PRIVATE_KEY=0x_your_deployer_private_key

# RPC URLs
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# ── Mobile (Expo) ────────────────────────────────
# API base URL override for device builds
# EXPO_PUBLIC_AQUARIUS_API_BASE_URL=http://127.0.0.1:3001
# Opt-in Anvil shared-key signing for local gas only (never enable in production)
# EXPO_PUBLIC_AQUARIUS_DEV_SIGNER=1

# ── Database (future) ────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/aquarius
# REDIS_URL=redis://localhost:6379
