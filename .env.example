# Aquarius Environment Configuration
# Copy this to .env and fill in your values

# ── API Server ──────────────────────────────────
# xAI (Grok) — primary provider for paid AI features (legal generate/summarize, Blue chat).
# Paid AI routes require a wallet session.
XAI_API_KEY=

# Optional Anthropic fallback when XAI_API_KEY is unset, or when a Grok call fails.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Legal long-form model (default: grok-4). Prefer a capable model — not the tiny fast chat model.
# LEGAL_GROK_MODEL=grok-4
# AQUARIUS_GROK_MODEL=grok-4

# Blue chat model override (default: grok-4-fast-non-reasoning for low-latency replies)
# BLUE_GROK_MODEL=grok-4-fast-non-reasoning

# API port (default 3001)
PORT=3001

# Set to production in deployed environments (also honors NODE_ENV=production)
# AQUARIUS_ENV=production

# Required in production: HMAC secret for API session tokens
# Generate with: openssl rand -hex 32
AQUARIUS_AUTH_SECRET=

# Comma-separated browser origins allowed by CORS.
# In development, localhost Expo/web origins are used when unset.
# In production, leave unset to deny browser cross-origin, or set explicitly.
# AQUARIUS_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Public base URL used in generated agent-card metadata URIs
# AQUARIUS_PUBLIC_API_BASE_URL=https://api.example.com

# Durable JSON bridge for Agent Foundry passports / runtime configs
# AGENT_STORE_FILE=./packages/api/data/agents.json
# AGENT_RUNTIME_BASE_URL=http://localhost:3001/api/agents
# AQUARIUS_CHAIN_NAME=local-or-base

# ── Agent security ──────────────────────────────
# Encrypts generated agent private keys before in-memory storage
# AGENT_KEY_ENCRYPTION_SECRET=

# Opt-in gate for operator wallet funding / on-chain registration (default: off)
# AGENT_OPERATOR_ACTIONS_ENABLED=false

# Optional comma-separated wallet allowlist for operator-funded actions
# AGENT_OPERATOR_ALLOWLIST=0xYourAdminWallet

# Max ETH the API will send when initialFundingEth > 0 (default 0.01)
# AGENT_MAX_INITIAL_FUNDING_ETH=0.01

# Operator wallet used only when operator actions are enabled
# AQUARIUS_OPERATOR_PRIVATE_KEY=0x_your_operator_private_key
# Also used to verify ERC-1271 smart-contract wallet SIWE signatures.
# AQUARIUS_RPC_URL=https://sepolia.base.org

# ── Smart Contract Deployment ────────────────────
# Private key for deploying contracts (DO NOT commit real keys)
PRIVATE_KEY=0x_your_deployer_private_key

# RPC URLs
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# ── Mobile (Expo) ────────────────────────────────
# API base URL override for device builds
# EXPO_PUBLIC_AQUARIUS_API_BASE_URL=http://127.0.0.1:3001
# Opt-in Anvil shared-key signing for local gas only (never enable in production)
# EXPO_PUBLIC_AQUARIUS_DEV_SIGNER=1

# ── Database ─────────────────────────────────────
# Postgres for durable auth sessions/challenges (and Agent Foundry schema).
# When unset, auth falls back to in-process memory (not durable across restarts).
# Apply packages/api/drizzle/0001_agent_persistence.sql, 0002_auth_sessions.sql,
# and 0003_indexer.sql.
# DATABASE_URL=postgresql://user:password@localhost:5432/aquarius
# REDIS_URL=redis://localhost:6379

# ── On-chain event indexer stub ─────────────────
# Catch-up + watchContractEvent for CommunityFactory / Community / Governance.
# Unset RPC keeps the read API up with an idle health payload (in-memory store).
# INDEXER_START_BLOCK=0
# AQUARIUS_COMMUNITY_FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# AQUARIUS_GOVERNANCE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# INDEXER_POLL_INTERVAL_MS=4000
# INDEXER_DISABLED=false
